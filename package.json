{
  "name": "fotoin",
  "version": "0.1.0",
  "private": true,
  "description": "FOTOIN - Hybrid AI product photography service for Indonesian UMKM",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "setup": "npm install && node scripts/setup.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
