# ---- Server ----
PORT=4000
NODE_ENV=development
PUBLIC_URL=http://localhost:4000
# Where sellers open their order page. Used for the download link in WhatsApp messages.
WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Where uploads, results and db.json are kept. Defaults to server/storage.
# STORAGE_DIR=

# ---- Upload limits ----
MAX_UPLOAD_MB=10
MAX_FILES_PER_ORDER=5

# ---- AI image provider ----
# mock   = pastes the whole photo as a rectangle, no API key, offline (default).
#          Does NOT remove the background; also the emergency demo fallback.
# local  = real background removal by the Python pipeline in pipeline/, on CPU,
#          free, no key. Start it first:
#          cd pipeline && .venv/bin/uvicorn fotoin.api:app --port 8000
# gemini = a Gemini image model edits the seller's photo into each style's scene,
#          one call per style (paid, needs a billing-enabled key). Not used for now.
IMAGE_PROVIDER=mock
# local provider: where the Python pipeline listens.
LOCAL_PIPELINE_URL=http://localhost:8000
# gemini only: Google AI Studio key (https://aistudio.google.com/apikey). Image
# models have no free tier. Also used by REFINER_PROVIDER=gemini when
# REFINER_API_KEY is empty.
IMAGE_PROVIDER_API_KEY=
# Empty = gemini-3.1-flash-image (~US$0.067 per image). Cheaper:
# gemini-3.1-flash-lite-image (~US$0.034). Stronger: gemini-3-pro-image (~US$0.134).
IMAGE_PROVIDER_MODEL=
# One image call usually takes 10-40 s; this only bounds a hung request.
IMAGE_PROVIDER_TIMEOUT_MS=90000
# Spend guard: max paid image calls per generation run (= styles in the order).
# The biggest pack has 5 styles. A reviewer rerun is a new run.
IMAGE_MAX_CALLS_PER_ORDER=5

# Simulated latency of the generation step, in ms (mock provider only)
MOCK_GENERATION_DELAY_MS=2500

# ---- Seller text refiner ----
# Turns the seller's own words (product notes) into structured English before generation.
# rules  = built in, offline, no key needed (default)
# gemini = a Gemini model also reads the notes; falls back to rules on any failure
REFINER_PROVIDER=rules
# Google AI Studio key. Left empty, IMAGE_PROVIDER_API_KEY is reused when IMAGE_PROVIDER
# is the same vendor. Free-tier inputs may be used by Google to improve its products, so
# use a paid key once real sellers' notes go through it.
REFINER_API_KEY=
# Empty = the default model (gemini-3.5-flash-lite)
REFINER_MODEL=
REFINER_TIMEOUT_MS=8000

# ---- Human QA ----
# Set to false to auto-approve (skips the human reviewer step). Keep true: the
# human check is FOTOIN's core differentiator.
REQUIRE_HUMAN_REVIEW=true
REVIEWER_TOKEN=dev-reviewer-token
# Max times a reviewer may send one order back to the generator (a loop guard).
REVIEW_MAX_RERUNS=2

# ---- WhatsApp Business API (delivery channel) ----
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=fotoin-verify
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# ---- Payments (QRIS / e-wallet) ----
# mock | midtrans | xendit
PAYMENT_PROVIDER=mock
PAYMENT_SERVER_KEY=
PAYMENT_IS_PRODUCTION=false
